# Command Center — Environment Configuration
# Copy this file to .env and fill in your values: cp .env.example .env

# Server port (default: 3000)
PORT=3000
HOST=0.0.0.0

# Optional localhost-only API listener for local programs on the same machine
# Recommended when you want a public CommandCenter UI/API plus a separate no-key local automation surface.
LOCAL_API_ENABLED=false
LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=3001

# OpenClaw Gateway connection
# Leave GATEWAY_TOKEN blank if CommandCenter is running on the same machine as OpenClaw;
# it will try to auto-detect the token from ~/.openclaw/openclaw.json.
GATEWAY_URL=ws://127.0.0.1:18789
GATEWAY_TOKEN=

# Demo mode
# SECURITY: defaults to OFF. Only set true for a safe UI preview; demo mode
# never disables operator auth (setup + session cookies are always enforced).
# true  = UI preview / simulated activity allowed
# false = connect to a real OpenClaw gateway (recommended for production)
DEMO_MODE=false

# Legacy voice env key.
# Modern voice/STT setup is mostly configured in the Settings UI instead.
# Premium TTS/STT providers now include Fish Audio via AIChat and ElevenLabs.
OPENAI_API_KEY=

# Weather widget location (City,Region,Country — used by wttr.in)
WEATHER_LOCATION=Kingston,Ontario,Canada

# Bearer token for the public CommandCenter API v1 listener
# Required for the public/network-facing API.
# The separate localhost-only LOCAL_API listener can stay no-key for trusted local programs.
COMMANDCENTER_API_KEY=
REIKA_EMBED_TOKEN=

# Optional Hermes bridge integration
# Set true to detect Hermes profiles and merge them into the same roster/dashboard as OpenClaw agents.
# Hermes and OpenClaw can co-exist in one CommandCenter instance.
HERMES_BRIDGE_ENABLED=false
HERMES_BIN=hermes
HERMES_AGENT_ID=hermes
HERMES_AGENT_LABEL=Nyxie
HERMES_AGENT_NAME=Nyxie
HERMES_AGENT_MODEL=

# Built-in updater note
# Auto-update is opt-in from the Settings UI.
# Updater preferences/state are stored under data/update-settings.json and data/update-state.json.
# No extra env var is required unless you customize your git/runtime environment outside this template.

# Lightweight roleplay/direct-chat path via OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ROLEPLAY_MODEL=z-ai/glm-5
OPENROUTER_HTTP_REFERER=https://techexplore.us/commandcenter/
OPENROUTER_APP_TITLE=Command Center

# Optional runtime-state retention (keeps disk from growing without bound)
LIVE_TASK_RETENTION_DAYS=90
LIVE_TASK_MAX_COUNT=500

# Update safety: after an update restarts the server, the new process probes
# /api/health and rolls back to the previous commit if it does not come up
# healthy within the window below. Set to 0 to disable the post-restart check.
UPDATE_HEALTHCHECK_TIMEOUT_MS=30000

# Optional explicit Python 3 executable. Windows also supports the py -3 launcher.
PYTHON_BIN=
