# Command Center — Environment Configuration
# Copy this file to .env and fill in your values: cp .env.example .env

# Server port (default: 3000)
PORT=3000

# OpenClaw Gateway connection
# Leave GATEWAY_TOKEN blank if CommandCenter is running on the same machine as OpenClaw;
# it will try to auto-detect the token from ~/.openclaw/openclaw.json.
GATEWAY_URL=ws://127.0.0.1:18789
GATEWAY_TOKEN=

# Demo mode
# true  = UI preview / simulated activity allowed
# false = connect to a real OpenClaw gateway
DEMO_MODE=true

# Legacy voice env key.
# Modern voice/STT setup is mostly configured in the Settings UI instead.
# Premium TTS/STT providers now include Fish Audio via AIChat and ElevenLabs.
OPENAI_API_KEY=

# Weather widget location (City,Region,Country — used by wttr.in)
WEATHER_LOCATION=Kingston,Ontario,Canada

# Optional bearer token for CommandCenter API v1
# If blank, /api/v1 routes are unauthenticated.
COMMANDCENTER_API_KEY=

# Optional Hermes bridge integration
# Set true to detect Hermes profiles and merge them into the same roster/dashboard as OpenClaw agents.
# Hermes and OpenClaw can co-exist in one CommandCenter instance.
HERMES_BRIDGE_ENABLED=false
HERMES_BIN=hermes
HERMES_AGENT_ID=hermes
HERMES_AGENT_LABEL=Nyxie
HERMES_AGENT_NAME=Nyxie
HERMES_AGENT_MODEL=

# Built-in updater note
# Auto-update is enabled by default from the Settings UI.
# Updater preferences/state are stored under data/update-settings.json and data/update-state.json.
# No extra env var is required unless you customize your git/runtime environment outside this template.

# Lightweight roleplay/direct-chat path via OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ROLEPLAY_MODEL=z-ai/glm-5
OPENROUTER_HTTP_REFERER=https://techexplore.us/commandcenter/
OPENROUTER_APP_TITLE=Command Center
