{
  "openapi": "3.1.0",
  "info": {
    "title": "CommandCenter API",
    "version": "1.0.0",
    "description": "API for agent lookup, session-based chat, optional SSE streaming, optional audio responses using each agent's configured CommandCenter voice, file attachments via reusable chat library IDs, session search, and voice assignment updates. Use Authorization: Bearer YOUR_COMMANDCENTER_API_KEY in examples."
  },
  "servers": [
    {
      "url": "https://your-domain.example/commandcenter/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "error",
          "code"
        ]
      },
      "SessionMeta": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "messageCount": {
            "type": "integer"
          },
          "lastMessagePreview": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "agent",
          "createdAt",
          "updatedAt",
          "messageCount"
        ]
      },
      "Message": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "text": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "meta": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "role",
          "text",
          "timestamp"
        ]
      },
      "AttachmentRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "link"
            ]
          },
          "name": {
            "type": "string"
          },
          "originalName": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string"
          },
          "downloadUrl": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "mimeType"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/agents": {
      "get": {
        "summary": "List agents",
        "responses": {
          "200": {
            "description": "Agent list"
          }
        }
      }
    },
    "/agents/search": {
      "get": {
        "summary": "Search agents",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results"
          }
        }
      }
    },
    "/files": {
      "get": {
        "summary": "List reusable files and links",
        "responses": {
          "200": {
            "description": "File list"
          }
        }
      }
    },
    "/files/upload": {
      "post": {
        "summary": "Upload files directly to the API file library",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                },
                "required": [
                  "files"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Uploaded files"
          }
        }
      }
    },
    "/files/link": {
      "post": {
        "summary": "Save a reusable link directly to the API file library",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  }
                },
                "required": [
                  "url"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved link"
          }
        }
      }
    },
    "/files/{id}/download": {
      "get": {
        "summary": "Download a file or redirect to a saved link",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File download"
          },
          "302": {
            "description": "Redirect for link items"
          },
          "404": {
            "description": "File not found"
          }
        }
      }
    },
    "/sessions": {
      "get": {
        "summary": "List sessions",
        "parameters": [
          {
            "name": "agent",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session list"
          }
        }
      },
      "post": {
        "summary": "Create session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "agent": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "agent"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session created"
          }
        }
      }
    },
    "/sessions/search": {
      "get": {
        "summary": "Search sessions by content",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agent",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results"
          }
        }
      }
    },
    "/sessions/{id}": {
      "get": {
        "summary": "Get session metadata",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session metadata"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/sessions/{id}/messages": {
      "get": {
        "summary": "Get session transcript",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session messages"
          }
        }
      },
      "post": {
        "summary": "Send a message to an existing session",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "fileIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "audio": {
                    "type": "boolean",
                    "description": "If true, also return an audio rendition using the agent's configured CommandCenter voice."
                  }
                },
                "required": [
                  "message"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Turn completed"
          }
        }
      }
    },
    "/sessions/{id}/messages/stream": {
      "post": {
        "summary": "Stream a message response over SSE",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "fileIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "audio": {
                    "type": "boolean",
                    "description": "If true, also return an audio rendition using the agent's configured CommandCenter voice."
                  }
                },
                "required": [
                  "message"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "summary": "Convenience chat endpoint",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "agent": {
                    "type": "string"
                  },
                  "sessionId": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "fileIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "audio": {
                    "type": "boolean",
                    "description": "If true, also return an audio rendition using the agent's configured CommandCenter voice."
                  }
                },
                "required": [
                  "message"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Turn completed"
          }
        }
      }
    },
    "/voice": {
      "get": {
        "summary": "Get CommandCenter voice settings and resolve the voice for an agent",
        "parameters": [
          {
            "name": "agent",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Voice settings"
          }
        }
      },
      "post": {
        "summary": "Update voice settings or assign a voice to an agent",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "enum": [
                      "elevenlabs",
                      "fish"
                    ]
                  },
                  "agent": {
                    "type": "string"
                  },
                  "voiceId": {
                    "type": "string"
                  },
                  "defaultVoiceId": {
                    "type": "string"
                  },
                  "fishVoiceId": {
                    "type": "string"
                  },
                  "elevenlabsAgentVoices": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "fishAgentVoices": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated voice settings"
          }
        }
      }
    },
    "/voice/options": {
      "get": {
        "summary": "List available voices for the current provider or search Fish voices",
        "parameters": [
          {
            "name": "provider",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "elevenlabs",
                "fish"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Required for Fish voice search."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 8
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Voice list or Fish search results"
          }
        }
      }
    }
  }
}
